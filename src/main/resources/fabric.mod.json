{
	"schemaVersion": 1,
	"id": "direcium",
	"version": "${version}",
	"name": "Direcium",
	"description": "Lets Sodium's terrain renderer draw through DirectExp's Direct3D 11 backend. Requires Sodium and DirectExp.",
	"authors": [
		"Cubcraftv"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/cubcraftv/Direcium"
	},
	"license": "Apache License 2.0",
	"icon": "assets/direcium/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"dev.cubcraftv.direcium.Direcium"
		],
		"client": [
			"dev.cubcraftv.direcium.client.DireciumClient"
		],
		"sodium:config_api_user": [
			"dev.cubcraftv.direcium.client.DireciumConfig"
		]
	},
	"mixins": [
		{
			"config": "direcium.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": ">=26.3",
		"java": ">=25",
		"fabric-api": "*",
		"sodium": "${sodium_version_range}",
		"directexp": "*"
	}
}